{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "ARM Template für hochverfügbare Unternehmenswebsite — DLBSEPCP01_D",
    "author": "Antonio",
    "version": "1.0.0"
  },
  "parameters": {
    "appServicePlanName": {
      "type": "string",
      "defaultValue": "cloud-website-plan",
      "minLength": 2,
      "maxLength": 60,
      "metadata": {
        "description": "Name des App Service Plans. Muss zwischen 2 und 60 Zeichen lang sein."
      }
    },
    "webAppName": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60,
      "metadata": {
        "description": "Eindeutiger Name der Web App (wird Teil der URL). Muss zwischen 2 und 60 Zeichen lang sein."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure Region für alle Ressourcen"
      }
    },
    "appServicePlanSku": {
      "type": "string",
      "defaultValue": "F1",
      "allowedValues": ["F1", "S1"],
      "metadata": {
        "description": "SKU des App Service Plans: F1 (Free) oder S1 (Standard)"
      }
    },
    "cdnProfileName": {
      "type": "string",
      "defaultValue": "cloud-website-cdn",
      "metadata": {
        "description": "Name des CDN Profils"
      }
    },
    "cdnEndpointName": {
      "type": "string",
      "defaultValue": "cdn-azure-cloud",
      "metadata": {
        "description": "Eindeutiger Name des CDN Endpoints"
      }
    },
    "enableCdn": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "CDN-Bereitstellung aktivieren. Auf 'false' gesetzt, da Azure for Students keine CDN/Front Door-Ressourcen unterstützt. Bei einem Upgrade auf ein bezahltes Abonnement auf 'true' setzen."
      }
    },
    "appServicePlanCapacity": {
      "type": "int",
      "defaultValue": 1,
      "minValue": 1,
      "maxValue": 10,
      "metadata": {
        "description": "Anzahl der Instanzen im App Service Plan. Bei F1 Tier ist nur 1 erlaubt, bei S1 bis zu 10."
      }
    },
    "logRetentionInDays": {
      "type": "int",
      "defaultValue": 30,
      "minValue": 7,
      "maxValue": 365,
      "metadata": {
        "description": "Aufbewahrungsdauer für Logs und Metriken in Tagen. Gilt einheitlich für Application Insights und Log Analytics Workspace."
      }
    },
    "resourceTags": {
      "type": "object",
      "defaultValue": {
        "project": "cloud-website-portfolio",
        "environment": "proof-of-concept",
        "owner": "Antonio Prinz"
      },
      "metadata": {
        "description": "Tags für alle Ressourcen zur Governance und Kostenkontrolle."
      }
    }
  },
  "variables": {
    "appInsightsName": "[concat(parameters('webAppName'), '-insights')]",
    "isStandardTier": "[equals(parameters('appServicePlanSku'), 'S1')]",
    "autoScaleSettingsName": "[concat(parameters('appServicePlanName'), '-autoscale')]",
    "skuName": "[if(variables('isStandardTier'), 'S1', 'F1')]",
    "skuTier": "[if(variables('isStandardTier'), 'Standard', 'Free')]",
    "logAnalyticsName": "[concat(parameters('webAppName'), '-logs')]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2022-09-01",
      "name": "[parameters('appServicePlanName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('resourceTags')]",
      "sku": {
        "name": "[variables('skuName')]",
        "tier": "[variables('skuTier')]",
        "capacity": "[if(variables('isStandardTier'), parameters('appServicePlanCapacity'), 1)]"
      },
      "properties": {}
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2022-09-01",
      "name": "[parameters('webAppName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('resourceTags')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', parameters('appServicePlanName'))]",
        "[resourceId('Microsoft.Insights/components', variables('appInsightsName'))]"
      ],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', parameters('appServicePlanName'))]",
        "httpsOnly": true,
        "siteConfig": {
          "appSettings": [
            {
              "name": "APPINSIGHTS_INSTRUMENTATIONKEY",
              "value": "[reference(resourceId('Microsoft.Insights/components', variables('appInsightsName'))).InstrumentationKey]"
            },
            {
              "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
              "value": "[reference(resourceId('Microsoft.Insights/components', variables('appInsightsName'))).ConnectionString]"
            }
          ],
          "ftpsState": "Disabled",
          "minTlsVersion": "1.2",
          "http20Enabled": true,
          "phpVersion": ""
        }
      }
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2022-10-01",
      "name": "[variables('logAnalyticsName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('resourceTags')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": "[parameters('logRetentionInDays')]"
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[variables('appInsightsName')]",
      "location": "[parameters('location')]",
      "kind": "web",
      "tags": "[parameters('resourceTags')]",
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName'))]"
      ],
      "properties": {
        "Application_Type": "web",
        "RetentionInDays": "[parameters('logRetentionInDays')]",
        "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName'))]"
      }
    },
    {
      "condition": "[parameters('enableCdn')]",
      "type": "Microsoft.Cdn/profiles",
      "apiVersion": "2023-05-01",
      "name": "[parameters('cdnProfileName')]",
      "location": "Global",
      "tags": "[parameters('resourceTags')]",
      "metadata": {
        "comment": "Location 'Global' gemäß Azure-Spezifikation für CDN-Ressourcen. Bedingt deploybar über 'enableCdn'-Parameter, da Azure for Students keine CDN-Ressourcen unterstützt."
      },
      "sku": {
        "name": "Standard_AzureFrontDoor"
      },
      "properties": {}
    },
    {
      "condition": "[parameters('enableCdn')]",
      "type": "Microsoft.Cdn/profiles/afdEndpoints",
      "apiVersion": "2023-05-01",
      "name": "[concat(parameters('cdnProfileName'), '/', parameters('cdnEndpointName'))]",
      "location": "Global",
      "tags": "[parameters('resourceTags')]",
      "metadata": {
        "comment": "Location 'Global' gemäß Azure-Spezifikation für CDN-Ressourcen."
      },
      "dependsOn": [
        "[resourceId('Microsoft.Cdn/profiles', parameters('cdnProfileName'))]",
        "[resourceId('Microsoft.Web/sites', parameters('webAppName'))]"
      ],
      "properties": {
        "enabledState": "Enabled"
      }
    },
    {
      "condition": "[variables('isStandardTier')]",
      "type": "Microsoft.Insights/autoscalesettings",
      "apiVersion": "2022-10-01",
      "name": "[variables('autoScaleSettingsName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('resourceTags')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', parameters('appServicePlanName'))]"
      ],
      "properties": {
        "name": "[variables('autoScaleSettingsName')]",
        "targetResourceUri": "[resourceId('Microsoft.Web/serverfarms', parameters('appServicePlanName'))]",
        "enabled": true,
        "profiles": [
          {
            "name": "DefaultAutoScaleProfile",
            "capacity": {
              "minimum": "1",
              "maximum": "3",
              "default": "1"
            },
            "rules": [
              {
                "metricTrigger": {
                  "metricName": "CpuPercentage",
                  "metricResourceUri": "[resourceId('Microsoft.Web/serverfarms', parameters('appServicePlanName'))]",
                  "timeGrain": "PT1M",
                  "statistic": "Average",
                  "timeWindow": "PT5M",
                  "timeAggregation": "Average",
                  "operator": "GreaterThan",
                  "threshold": 70
                },
                "scaleAction": {
                  "direction": "Increase",
                  "type": "ChangeCount",
                  "value": "1",
                  "cooldown": "PT5M"
                }
              },
              {
                "metricTrigger": {
                  "metricName": "CpuPercentage",
                  "metricResourceUri": "[resourceId('Microsoft.Web/serverfarms', parameters('appServicePlanName'))]",
                  "timeGrain": "PT1M",
                  "statistic": "Average",
                  "timeWindow": "PT5M",
                  "timeAggregation": "Average",
                  "operator": "LessThan",
                  "threshold": 30
                },
                "scaleAction": {
                  "direction": "Decrease",
                  "type": "ChangeCount",
                  "value": "1",
                  "cooldown": "PT5M"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "Microsoft.Web/sites/providers/diagnosticSettings",
      "apiVersion": "2021-05-01-preview",
      "name": "[concat(parameters('webAppName'), '/Microsoft.Insights/diagnostics')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('webAppName'))]",
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName'))]"
      ],
      "properties": {
        "workspaceId": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName'))]",
        "logs": [
          { "category": "AppServiceHTTPLogs", "enabled": true },
          { "category": "AppServiceAppLogs", "enabled": true }
        ],
        "metrics": [
          { "category": "AllMetrics", "enabled": true }
        ]
      }
    }
  ],
  "outputs": {
    "webAppUrl": {
      "type": "string",
      "value": "[concat('https://', parameters('webAppName'), '.azurewebsites.net')]"
    },
    "cdnEndpointUrl": {
      "condition": "[parameters('enableCdn')]",
      "type": "string",
      "value": "[if(parameters('enableCdn'), concat('https://', reference(resourceId('Microsoft.Cdn/profiles/afdEndpoints', parameters('cdnProfileName'), parameters('cdnEndpointName'))).hostName), 'CDN nicht aktiviert')]"
    },
    "appInsightsInstrumentationKey": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/components', variables('appInsightsName'))).InstrumentationKey]"
    },
    "currentSku": {
      "type": "string",
      "value": "[parameters('appServicePlanSku')]"
    },
    "appInsightsPortalUrl": {
      "type": "string",
      "value": "[concat('https://portal.azure.com/#resource', resourceId('Microsoft.Insights/components', variables('appInsightsName')), '/overview')]"
    },
    "logAnalyticsPortalUrl": {
      "type": "string",
      "value": "[concat('https://portal.azure.com/#resource', resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName')), '/overview')]"
    },
    "resourceGroupPortalUrl": {
      "type": "string",
      "value": "[concat('https://portal.azure.com/#resource/subscriptions/', subscription().subscriptionId, '/resourceGroups/', resourceGroup().name, '/overview')]"
    }
  }
}
